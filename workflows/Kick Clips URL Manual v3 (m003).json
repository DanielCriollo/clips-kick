    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst moments = data.moments || [];\nif (moments.length === 0) {\n  return [{ json: { found: false, message: 'GPT no encontro momentos interesantes' } }];\n}\nreturn moments.map(function(m) {\n  // M003: inicio y duracion reales resueltos por el backend desde segmentos de Whisper.\n  // Respaldo: formato anterior (timestamp - 10 s y 55 s fijos).\n  const hasStart = m.start_seconds !== undefined && m.start_seconds !== null;\n  const hasDuration = m.duration_seconds !== undefined && m.duration_seconds !== null;\n  const start = hasStart ? Number(m.start_seconds) : Math.max(0, (m.timestamp_seconds || 0) - 10);\n  const duration = hasDuration ? Number(m.duration_seconds) : (parseInt(m.clip_duration) || 55);\n  return { json: {\n    found: true,\n    timestamp: Math.max(0, Math.floor(start)),\n    type: m.type || '',\n    tiktok_title: m.tiktok_title || m.type || '',\n    tiktok_description: m.tiktok_description || '',\n    call_to_action: m.call_to_action || '',\n    reason: m.reason || '',\n    quote: m.quote || '',\n    score: m.score || 0,\n    rank: m.rank || 0,\n    vodFile: m.vod_file || '',\n    audioDir: m.audio_dir || '',\n    reportFile: m.report_file || '/files/report_latest.txt',\n    clipDuration: Math.max(1, Math.round(duration))\n  }};\n});"
      },
