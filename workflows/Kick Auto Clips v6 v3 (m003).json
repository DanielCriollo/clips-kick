    {
      "parameters": {
        "jsCode": "const vid = $input.first().json;\nconst cfg = $('Configuracion').first().json;\nif (!vid || !vid.id) throw new Error('No hay VODs para el canal: ' + cfg.channel);\nconst url = vid.source || (vid.video && vid.video.url) || ('https://kick.com/video/' + vid.id);\nreturn [{ json: {\n  vod_url:       url,\n  open_ai_key:   cfg.openAiKey,\n  channel:       cfg.channel,\n  max_moments:   cfg.maxMoments,\n  clip_duration: cfg.clipDuration,\n  chunk_minutes: cfg.chunkMinutes\n}}];"
      },
