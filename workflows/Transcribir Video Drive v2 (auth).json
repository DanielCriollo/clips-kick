          "name": "Worker Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8080/transcribe",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ dir: $json.dir, chunks: $json.chunks, chunk_minutes: $json.chunk_minutes, vod_file: $json.vod_file }) }}",
        "options": {
          "timeout": 1200000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "aa000007-0000-0000-0000-000000000007",
