          "id": "REEMPLAZAR_CREDENCIAL_WORKER_TOKEN",
          "name": "Worker Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8080/extract_audio",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "input",
              "value": "={{ $json.file }}"
            },
            {
              "name": "chunk_minutes",
              "value": "={{ $json.chunk_minutes }}"
            }
          ]
        },
        "options": {
          "timeout": 600000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "aa000006-0000-0000-0000-000000000006",
      "name": "Extraer Audio",
      "type": "n8n-nodes-base.httpRequest",
