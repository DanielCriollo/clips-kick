      "id": "aa000002-0000-0000-0000-000000000002",
      "name": "Configuracion",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -10976,
        576
      ]
    },
    {
      "parameters": {
        "jsCode": "const url = $input.first().json.drive_url;\nconst config = $input.first().json;\n\n// Soporta formatos:\n// https://drive.google.com/file/d/{ID}/view\n// https://drive.google.com/open?id={ID}\n// https://docs.google.com/.../{ID}/...\nlet fileId = '';\nconst matchFile = url.match(/\\/file\\/d\\/([a-zA-Z0-9_-]+)/);\nconst matchOpen = url.match(/[?&]id=([a-zA-Z0-9_-]+)/);\nif (matchFile) fileId = matchFile[1];\nelse if (matchOpen) fileId = matchOpen[1];\nif (!fileId) throw new Error('No se pudo extraer el ID del archivo de Drive. URL: ' + url);\n\nreturn [{ json: {\n  file_id:       fileId,\n  open_ai_key:   config.open_ai_key,\n  chunk_minutes: config.chunk_minutes\n}}];"
      },
      "id": "aa000003-0000-0000-0000-000000000003",
      "name": "Extraer ID Drive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -10752,
        576
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.file_id }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "aa000004-0000-0000-0000-000000000004",
      "name": "Descargar Video Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        -10528,
        576
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "X9Wl41rAwsEolEus",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8080/save_file",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "chunk_minutes",
              "value": "={{ $('Extraer ID Drive').first().json.chunk_minutes }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "aa000005-0000-0000-0000-000000000005",
